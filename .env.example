# Salut! – Umgebungsvariablen
#
# Ohne diese Datei (bzw. ohne die beiden NEXT_PUBLIC_SUPABASE_*-Werte)
# läuft die App automatisch im lokalen Demo-Modus (localStorage, ein
# simuliertes Crew mit Bot-Mitgliedern) – kein Supabase nötig zum
# Ausprobieren.
#
# Für echtes Multi-Device-Play mit einer eigenen Crew: Datei nach ".env.local"
# kopieren und mit den Werten aus deinem Supabase-Projekt befüllen. Siehe
# SETUP.md für die Schritt-für-Schritt-Anleitung.

# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → Project API keys → service_role (GEHEIM HALTEN,
# nur server-seitig genutzt vom Geburtstags-Cron-Job unter
# src/app/api/cron/birthdays/route.ts – niemals mit NEXT_PUBLIC_ Präfix!)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: beliebiges Passwort, das der Cron-Job als Bearer-Token erwartet
# (schützt die Route davor, dass sie jemand von außen manuell aufruft).
# Vercel Cron sendet dieses Secret automatisch mit, wenn es gesetzt ist.
CRON_SECRET=
